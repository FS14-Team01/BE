# 실행 환경: 로컬에서는 development, 배포 환경에서는 production
NODE_ENV=development

# 로컬 백엔드 서버 포트
# Render에서는 자동으로 제공하므로 별도 설정하지 않아도 됨
PORT=3001

# PostgreSQL 연결 주소
# 로컬에서는 로컬 DB URL, 배포 환경에서는 배포 DB의 연결 URL 사용
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 아래 시크릿은 자리표시자다. 각각 아래 명령으로 만든 무작위 값으로 바꿔 쓴다.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# 토큰 만료 시간
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# API 요청을 허용할 프론트엔드 Origin
# 로컬 예시: http://localhost:3000
# 배포 예시: https://example.netlify.app
FRONTEND_URL=http://localhost:3000

# Google Cloud Console 에서 발급받은 값
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary 이미지 업로드
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=